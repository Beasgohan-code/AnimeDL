# ============================================================================
#  AnimeDL — environment configuration
#  Copy this file to `.env` and fill in your values.
# ============================================================================

# ── Required ──────────────────────────────────────────────────────────────
# From https://my.telegram.org → API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# From https://t.me/BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Your numeric Telegram user ID (get it from @userinfobot)
OWNER_ID=123456789
# MongoDB connection string (a free Atlas cluster works fine)
MONGO_URL=mongodb+srv://user:pass@cluster0.mongodb.net/?retryWrites=true&w=majority

# ── Recommended ───────────────────────────────────────────────────────────
# Telegram chat where leech uploads are sent (channel/group ID).
# A bare 10-digit ID is auto-converted to the -100… supergroup form.
DUMP_ID=-1001234567890
# Support/help link shown in the bot UI (your channel or username link)
SUPPORT_CONTACT=https://t.me/YourSupportChannel
# The bot's own @username (without @), used by force-sub links
BOT_USERNAME=YourBot

# ── Anime core (optional) ─────────────────────────────────────────────────
# MONGO_NAME=animedl
# Chat where anime episodes are posted; defaults to the requester's chat
# TARGET_CHAT_ID=-1001234567890
# Primary channel for posted episodes
# MAIN_CHANNEL=-1001234567890
# Channel for operational logs
# LOG_CHANNEL=-1001234567890
# Ongoing-episode scheduler interval (seconds)
# SET_INTERVAL=60
# Filename template: {season} {episode} {title} {quality} {audio}
# FORMAT=[S{season}-E{episode}] {title} [{quality}] [{audio}]
# File caption template
# CAPTION={FORMAT}
# Force-subscription prompt image URL
# FSUB_PIC=https://example.com/fsub.jpg
# /start screen image URL
# START_PIC=https://example.com/start.jpg
# Rotating reply images, comma-separated
# RESPONSE_IMAGES=https://img1.example.com/a.jpg,https://img2.example.com/b.jpg

# ── Leech engine (optional) ───────────────────────────────────────────────
# Default upload mode: media (streamable) or document (file)
# DEFAULT_UPLOAD_MODE=media
# Extra users allowed to use leech commands (comma-separated IDs);
# empty = owner only
# ALLOWED_USERS=111,222
# Bandwidth cap for aria2/yt-dlp, e.g. 10M
# BANDWIDTH_LIMIT=
# Scratch directory for downloads (defaults to /tmp/animedl)
# LEECHBOT_BASE_DIR=/tmp/animedl
# Google Drive token (created by the built-in GDrive flow)
# TOKEN_PICKLE_PATH=/tmp/animedl/token.pickle
# yt-dlp Netscape cookies.txt (or upload cookies.txt to the bot in chat)
# YTDL_COOKIES_FILE=/path/to/cookies.txt

# ── Web health server ─────────────────────────────────────────────────────
# WEB_PORT=8080
# Optional bearer token to protect /health
# WEB_TOKEN=
